#!/bin/bash

osname=$(uname)
jvm_args="-Xms64m -Xmx512m"

if [ "$osname" = "Linux" ]
then
    bin_dir=$( dirname $(readlink -f $0) )
elif [ "$osname" = "Darwin" ]
then
    exec_file=$(readlink $0||echo $0)
    bin_dir=$( dirname $exec_file )
    bin_dir=$( cd "$bin_dir" && pwd )
    jvm_args="-Dapple.awt.UIElement=true ${jvm_args}"
else
    bin_dir=$( cd "$( dirname "$0" )" && pwd )
fi

if java_version=$(java -version 2>&1 | awk -F '"' '/version/{split($2, a, "."); if(a[1]=="1") {print a[2]} else {print a[1]} }'); then
    if [[ "$java_version" =~ ^[0-9]+$ ]] && [ "$java_version" -ge 9 ]; then
        jvm_args="$jvm_args --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED --add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED"
    fi
fi

clt_dir="${bin_dir}/.."

if [ -n "$MAX_ODPSCMD_COUNT" ]
then
    process_count=`ps aux|grep -i ODPSConsole|grep -v grep|wc -l|tr -d '[[:space:]]'`
    while [ $process_count -gt $MAX_ODPSCMD_COUNT ]
    do
        echo "Detect $process_count odpscmd process(es) running, exceeds limit $MAX_ODPSCMD_COUNT, wait for 5 seconds ..."
        sleep 5
        process_count=`ps aux|grep -i ODPSConsole|grep -v grep|wc -l|tr -d '[[:space:]]'`
    done
fi

fd_dir="/proc/$$/fd"
if [ ! -d "$fd_dir" ]; then
    fd_dir="/dev/fd"
fi

function lowest_unused_fd() {
    local FD=10
    while [ -e "$fd_dir/$FD" ]; do
        FD=$((FD+1))
    done
    echo $FD
}

export TERM="xterm-256color"

if [ -d "$fd_dir" ]
then
    if ! file=$(mktemp -t "XXXXXXXX"); then
        echo "ERROR: failed to create temporary file for odpscmd arguments." >&2
        exit 1
    fi

    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo "ERROR: mktemp did not create a regular file for odpscmd arguments." >&2
        exit 1
    fi

    function cleanup_args_file() {
        if [ -n "$file" ] && [ -f "$file" ]; then
            rm -f -- "$file"
        fi
    }
    trap cleanup_args_file EXIT

    wfd=$(lowest_unused_fd)
    if ! eval "exec $wfd>\"\$file\""; then
        echo "ERROR: failed to open temporary file for odpscmd arguments." >&2
        exit 1
    fi

    for var in "$@"
    do
        if ! printf -- "%s\0" "$var" >&$wfd; then
            eval "exec $wfd>&-"
            echo "ERROR: failed to write temporary file for odpscmd arguments." >&2
            exit 1
        fi
    done

    if ! eval "exec $wfd>&-"; then
        echo "ERROR: failed to close temporary file for odpscmd arguments." >&2
        exit 1
    fi

    exec java $jvm_args -classpath "${clt_dir}/lib/mapreduce-api.jar:${clt_dir}/lib/*:${clt_dir}/conf/" com.aliyun.openservices.odps.console.ODPSConsole -I "$file"
else
    exec java $jvm_args -classpath "${clt_dir}/lib/mapreduce-api.jar:${clt_dir}/lib/*:${clt_dir}/conf/" com.aliyun.openservices.odps.console.ODPSConsole "$@"
fi
